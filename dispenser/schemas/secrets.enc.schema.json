{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/temakz/sol-dispenser/dispenser/schemas/secrets.enc.schema.json",
  "title": "EncryptedSecrets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cipher", "kdf", "salt", "iv", "tag", "ciphertext"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cipher": {
      "const": "aes-256-gcm"
    },
    "kdf": {
      "const": "scrypt"
    },
    "salt": {
      "type": "string",
      "minLength": 1
    },
    "iv": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "ciphertext": {
      "type": "string",
      "minLength": 1
    }
  }
}
