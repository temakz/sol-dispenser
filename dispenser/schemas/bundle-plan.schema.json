{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/temakz/sol-dispenser/dispenser/schemas/bundle-plan.schema.json",
  "title": "BundlePlan",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "cluster": { "const": "mainnet-beta" }
        },
        "required": ["cluster"]
      },
      "then": {
        "required": ["sourceWallet", "rescueWallet"],
        "properties": {
          "sourceWallet": {
            "type": "string",
            "minLength": 32
          },
          "rescueWallet": {
            "type": "string",
            "minLength": 32
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "cluster",
    "rpcUrl",
    "sourceWallet",
    "sourceWalletPath",
    "rescueWallet",
    "programId",
    "durableNonce",
    "walletCount",
    "totalLamports",
    "totalSol",
    "recipients",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string"
    },
    "cluster": {
      "type": "string",
      "enum": ["localnet", "devnet", "mainnet-beta"]
    },
    "rpcUrl": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "sourceWalletPath": {
      "type": "string",
      "minLength": 1
    },
    "sourceWallet": {
      "type": "string",
      "pattern": "^$|^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "rescueWallet": {
      "type": "string",
      "pattern": "^$|^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "programId": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "durableNonce": {
      "const": true
    },
    "walletCount": {
      "type": "integer",
      "minimum": 1
    },
    "totalLamports": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "totalSol": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,9})?$"
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "address", "amountLamports", "amountSol"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "address": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "amountLamports": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "amountSol": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,9})?$"
          }
        }
      }
    },
    "status": {
      "const": "planned"
    }
  }
}
