{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/temakz/sol-dispenser/dispenser/schemas/config.schema.json",
  "title": "DispenserConfig",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "cluster": { "const": "mainnet-beta" }
        },
        "required": ["cluster"]
      },
      "then": {
        "required": ["sourceWallet", "rescueWallet"],
        "properties": {
          "sourceWallet": {
            "type": "string",
            "minLength": 32
          },
          "rescueWallet": {
            "type": "string",
            "minLength": 32
          }
        }
      }
    }
  ],
  "required": [
    "cluster",
    "rpcUrl",
    "sourceWalletPath",
    "rescueWallet",
    "programId",
    "maxSolPerRun",
    "requireMainnetTypedConfirmation"
  ],
  "properties": {
    "cluster": {
      "type": "string",
      "enum": ["localnet", "devnet", "mainnet-beta"]
    },
    "rpcUrl": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "sourceWalletPath": {
      "type": "string",
      "minLength": 1
    },
    "sourceWallet": {
      "type": "string",
      "pattern": "^$|^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "rescueWallet": {
      "type": "string",
      "pattern": "^$|^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "programId": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "maxSolPerRun": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,9})?$"
    },
    "requireMainnetTypedConfirmation": {
      "const": true
    }
  }
}
