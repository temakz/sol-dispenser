# Copy to .env for local operator settings. .env is ignored by git.
# Do not paste real private keys into this tracked example file.

MAINNET_CLUSTER=mainnet-beta
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
MAINNET_PROGRAM_ID=6t1gxhFQqjRj3W6uTJM9xwzPbDv9QyWGNu2f9FEv6j5

MAINNET_SOURCE_WALLET=Cpe3umG1pQj9TRC9QcF2Js8fLr9bmsNPt5vPzMRUqRMN

# Put the real private key only in local .env, then run:
# npm run dispenser -- wallet-from-env
# The command writes MAINNET_SOURCE_WALLET_PATH and verifies it matches MAINNET_SOURCE_WALLET.
MAINNET_SOURCE_PRIVATE_KEY=<paste-private-key-in-local-.env-only>
MAINNET_SOURCE_WALLET_PATH=./wallet-mainnet.json

MAINNET_RESCUE_WALLET=HizKAdiBbivBDiv8hojaCcHzoZrVpj8S78M2x5XXQZwn
MAINNET_MAX_SOL_PER_RUN=20
MAINNET_REQUIRE_TYPED_CONFIRMATION=true

# Optional local-only passphrase for encrypted run secrets.
# This is not your wallet private key. It encrypts/decrypts generated disposable wallet seeds.
# DISPENSER_PASSPHRASE=
